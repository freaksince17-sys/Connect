rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.category is string && data.category.size() <= 64
        && data.price is number && data.price >= 0
        && data.images is list && data.images.size() <= 20;
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }

    match /tiktok_reels/{reelId} {
      allow get, list: if true;
      allow create, update: if isValidId(reelId);
      allow delete: if isValidId(reelId);
    }

    match /instagram_journal/{itemId} {
      allow get, list: if true;
      allow create, update: if isValidId(itemId);
      allow delete: if isValidId(itemId);
    }

    match /store_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}
